/data/
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Design reference shots (third-party work, local only)
/.design_ideas/
