# Build output
/dist/
/bin/
*.exe

# Frontend build embedded into the Go binary (keep the placeholder)
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Frontend
/web/node_modules/
/web/dist/
/web/dev-dist/
/web/coverage/
