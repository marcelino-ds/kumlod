# Production configuration (/etc/kumlod/kumlod.env, owner root:kumlod, mode 640).
# setup-vps.sh fills __EMAIL__. Restart after changes: sudo systemctl restart kumlod
KUMLOD_ADDR=127.0.0.1:8080
KUMLOD_DATA_DIR=/var/lib/kumlod/data
KUMLOD_TRUST_PROXY=true
KUMLOD_VAPID_SUBJECT=mailto:__EMAIL__
KUMLOD_MAX_UPLOAD_MB=50
KUMLOD_LOG_FORMAT=json
