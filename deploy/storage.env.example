# S3-compatible object storage for backups (/etc/kumlod/storage.env, owner root:kumlod, mode 640).
# Litestream replicates the database continuously; rclone copies material files daily.
# Leave KUMLOD_S3_BUCKET empty to keep backups off. After filling it, run setup-vps.sh again.
KUMLOD_S3_BUCKET=
# Required for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
KUMLOD_S3_ENDPOINT=
# AWS region, or what your provider expects (e.g. auto for Cloudflare R2)
KUMLOD_S3_REGION=
KUMLOD_S3_ACCESS_KEY_ID=
KUMLOD_S3_SECRET_ACCESS_KEY=
# rclone provider name: Other, AWS, Cloudflare, Wasabi, Minio, DigitalOcean, ...
KUMLOD_S3_PROVIDER=Other
